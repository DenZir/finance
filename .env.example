# Порт, на который Caddy ведёт dengi.routaterm.icu
PORT=30010
# Файл базы (в контейнере — /app/data/finance.db, папка ./data смонтирована)
DB_PATH=./data/finance.db

# Бот для входа через Telegram: токен из @BotFather и имя без @.
# У бота в @BotFather: /setdomain → dengi.routaterm.icu — иначе кнопка входа не работает.
BOT_TOKEN=
BOT_USERNAME=
# Кого пускать: Telegram ID владельца (можно несколько через запятую)
OWNER_TG_IDS=

# Импорт оплат привата (раз в 5 минут). Пусто — выключен.
# BOTPRIVAT_URL — адрес ботприватa на этой машине; BOTPRIVAT_KEY — его FINANCE_API_KEY.
# IMPORT_SINCE — с какой даты брать оплаты и сделки; на эту же дату внесите «Остаток» кошельков.
BOTPRIVAT_URL=http://127.0.0.1:30003
BOTPRIVAT_KEY=
IMPORT_SINCE=

# Сделки рекламы из tg-analytics (раз в 5 минут): закупы и продажи ждут отметки
# «оплачено» или «бартер». Пусто — выключены.
# ANALYTICS_KEY — его FINANCE_KEY (в .env tg-analytics; сгенерировать: openssl rand -hex 32).
ANALYTICS_URL=http://127.0.0.1:3000
ANALYTICS_KEY=

# Оплаты VPN из tg-analytics (тем же ключом, раз в 5 минут): имя проекта VPN
# в аналитике, как на её экране «Проекты». Пусто — выключены.
VPN_PROJECT=
